<Window x:Class="PrintStudio.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="শিট প্রিন্ট প্রিভিউ — Print Studio"
        Icon="app_icon.png"
        Height="720" Width="840"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- Top Controls Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DocTitleText" Text="ডকুমেন্ট নাম" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,12,0"/>
                    <Border Background="#EFF6FF" CornerRadius="10" Padding="8,2">
                        <TextBlock x:Name="SpecsText" Text="N-Up: 1 • A4 • B&amp;W" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnPrevSheet" Content="◀ পূর্ববর্তী" Width="76" Height="30" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,6,0" Cursor="Hand" Click="BtnPrevSheet_Click"/>
                    <TextBlock x:Name="SheetCounterText" Text="শিট ১ / ১" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="6,0,10,0"/>
                    <Button x:Name="BtnNextSheet" Content="পরবর্তী ▶" Width="76" Height="30" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="BtnNextSheet_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Preview Canvas Scroll Area -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#64748B" Padding="20">
            <Border Background="White" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35"/>
                </Border.Effect>
                <Image x:Name="PreviewImage" Stretch="None"/>
            </Border>
        </ScrollViewer>

        <!-- Bottom Footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="💡 বর্তমান N-Up, মার্জিন, বর্ডার এবং কালার সেটিং অনুযায়ী প্রিভিউ দেখানো হচ্ছে" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                <Button Content="বন্ধ করুন" Width="80" Height="30" HorizontalAlignment="Right" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="BtnClose_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
