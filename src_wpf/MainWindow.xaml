<Window x:Class="PrintStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Studio — স্মার্ট ব্যাচ প্রিন্টিং"
        Icon="app_icon.png"
        Height="730" Width="1120"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/> <!-- Hardware Alert Banner -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,0">
            <DockPanel VerticalAlignment="Center">
                <!-- Brand Left -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,12,0" ClipToBounds="True">
                        <Image Source="app_icon.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Print Studio" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="স্মার্ট ব্যাচ প্রিন্টিং ও স্পুলার ইঞ্জিন" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>

                    <!-- Top Navigation Tabs -->
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabWorkspaceBtn" Content="প্রিন্ট স্টুডিও" Height="28" Padding="14,0" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="TabWorkspace_Click"/>
                            <Button x:Name="TabQueueBtn" Content="লাইভ প্রিন্ট কিউ" Height="28" Padding="14,0" Background="Transparent" Foreground="#475569" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="TabQueue_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Status & About Right -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Live Status Badge -->
                    <Border x:Name="ActivePrinterBadge" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ActivePrinterNameText" Text="প্রিন্টার খোঁজা হচ্ছে..." FontSize="12" Foreground="#334155" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ActivePrinterStatusTag" Text="রেডি" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                        </StackPanel>
                    </Border>

                    <!-- Refresh Button -->
                    <Button x:Name="BtnRefresh" Width="32" Height="32" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand" ToolTip="প্রিন্টার ও কিউ রিফ্রেশ করুন" Click="BtnRefresh_Click">
                        <TextBlock Text="🔄" FontSize="12"/>
                    </Button>

                    <!-- About Tab Button -->
                    <Button x:Name="BtnAbout" Height="32" Padding="12,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" ToolTip="অ্যাপ ও ডেভেলপার তথ্য" Click="BtnAbout_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️ " FontSize="11" Margin="0,0,2,0"/>
                            <TextBlock Text="About" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Hardware Alert Banner (Appears dynamically on Paper Out, Paper Jam, Door Open, Offline) -->
        <Border Grid.Row="1" x:Name="HardwareAlertBanner" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="0,0,0,1" Padding="16,8" Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="AlertIconText" Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="AlertMessageText" Text="প্রিন্টারে সমস্যা সনাক্ত হয়েছে" FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C" VerticalAlignment="Center"/>
                <Button Content="পুনরায় চেক করুন" HorizontalAlignment="Right" Background="White" Foreground="#B91C1C" BorderBrush="#FCA5A5" BorderThickness="1" Padding="8,2" FontSize="11" Cursor="Hand" Click="BtnRefresh_Click"/>
            </DockPanel>
        </Border>

        <!-- TAB 1: WORKSPACE VIEW -->
        <Grid Grid.Row="2" x:Name="WorkspaceView" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Drag Drop & File Queue -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Drag Drop Zone -->
                <Border Grid.Row="0" x:Name="DropZone" Background="White" BorderBrush="#93C5FD" BorderThickness="2" CornerRadius="8" Padding="12" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" MouseLeftButtonDown="DropZone_Click" Cursor="Hand" Margin="0,0,0,12">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="☁️" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock Text="পিডিএফ ফাইলগুলো এখানে ড্র্যাগ করে ছেড়ে দিন" FontSize="13" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                        <TextBlock Text="অথবা কম্পিউটার থেকে ফাইল সিলেক্ট করতে এখানে ক্লিক করুন" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Queue Header -->
                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock x:Name="QueueStatsText" Text="প্রিন্ট কিউ (০টি ফাইল • মোট ০ পেজ)" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnClearAll" Content="সব মুছুন" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Padding="8,4" FontSize="11" Margin="0,0,6,0" Cursor="Hand" Click="BtnClearAll_Click"/>
                        <Button x:Name="BtnAddMore" Content="+ আরও যোগ করুন" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,4" FontSize="11" Cursor="Hand" Click="BtnAddMore_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- File Cards List -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6">
                    <ListBox x:Name="FileList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Thumbnail -->
                                            <Border Grid.Column="0" Width="46" Height="60" Background="#E2E8F0" CornerRadius="4" Margin="0,0,10,0">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                            </Border>

                                            <!-- File Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="#64748B" Margin="0,1,0,3"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding PageCount, StringFormat='{}{0} পেজ'}" FontSize="10" FontWeight="SemiBold" Foreground="#2563EB"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DetectedOrientation, StringFormat='ওরিয়েন্টেশন: {0}'}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Card Quick Actions -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ToggleButton Content="⚙️ কাস্টম" Width="68" Height="26" IsChecked="{Binding UseCustomSettings, Mode=TwoWay}" FontSize="11" Margin="0,0,6,0" Cursor="Hand"/>
                                                <Button Content="✕" Width="26" Height="26" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Tag="{Binding Id}" Click="BtnRemoveItem_Click" Cursor="Hand" ToolTip="ফাইল মুছুন"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Expandable Per-File Settings Panel -->
                                        <Border Margin="0,8,0,0" Padding="10" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UseCustomSettings}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="পেজ রেঞ্জ (e.g. 1-3, 5, odd)" FontSize="10" Foreground="#64748B"/>
                                                    <TextBox Text="{Binding PageRange, Mode=TwoWay}" Height="24" FontSize="11" Padding="2"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                    <TextBlock Text="কপি সংখ্যা" FontSize="10" Foreground="#64748B"/>
                                                    <TextBox Text="{Binding Copies, Mode=TwoWay}" Height="24" FontSize="11" Padding="2" TextAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                    <TextBlock Text="কালার" FontSize="10" Foreground="#64748B"/>
                                                    <ComboBox SelectedValue="{Binding CustomColor, Mode=TwoWay}" SelectedValuePath="Tag" Height="24" FontSize="11">
                                                        <ComboBoxItem Content="গ্লোবাল" Tag="default"/>
                                                        <ComboBoxItem Content="B&amp;W" Tag="bw"/>
                                                        <ComboBoxItem Content="কালার" Tag="color"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="ওরিয়েন্টেশন" FontSize="10" Foreground="#64748B"/>
                                                    <ComboBox SelectedValue="{Binding CustomOrientation, Mode=TwoWay}" SelectedValuePath="Tag" Height="24" FontSize="11">
                                                        <ComboBoxItem Content="গ্লোবাল" Tag="default"/>
                                                        <ComboBoxItem Content="পোর্ট্রেট" Tag="portrait"/>
                                                        <ComboBoxItem Content="ল্যান্ডস্কেপ" Tag="landscape"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- RIGHT: Print Settings & One-Click Print -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Settings Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="⚙️ প্রিন্ট সেটিংস (Global)" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="সব ফাইলের ডিফল্ট" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- Settings Form Controls -->
                    <StackPanel Grid.Row="1">
                        <!-- Printer Select -->
                        <TextBlock Text="কানেক্টেড প্রিন্টার" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PrinterCombo" Height="32" SelectionChanged="PrinterCombo_SelectionChanged" Margin="0,0,0,10"/>

                        <!-- Row 1: Color & Quality -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="কালার মোড" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ColorCombo" Height="30" SelectionChanged="SettingChanged">
                                    <ComboBoxItem Content="B&amp;W (সাদা-কালো)" Tag="bw" IsSelected="True"/>
                                    <ComboBoxItem Content="কালার (Color)" Tag="color"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="কোয়ালিটি (DPI)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox x:Name="QualityCombo" Height="30" SelectionChanged="SettingChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Paper Size & Duplex -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="সাইজ" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox x:Name="PaperCombo" Height="30" SelectionChanged="SettingChanged">
                                    <ComboBoxItem Content="A4 (210×297)" Tag="A4" IsSelected="True"/>
                                    <ComboBoxItem Content="Letter" Tag="Letter"/>
                                    <ComboBoxItem Content="Legal" Tag="Legal"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ডুপ্লেক্স" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox x:Name="DuplexCombo" Height="30" SelectionChanged="SettingChanged">
                                    <ComboBoxItem Content="সিঙ্গেল (একপিঠ)" Tag="simplex" IsSelected="True"/>
                                    <ComboBoxItem Content="ডুপ্লেক্স (বইয়ের মতো)" Tag="vertical"/>
                                    <ComboBoxItem Content="ডুপ্লেক্স (শর্ট এজ)" Tag="horizontal"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: N-Up Selection & Border Checkbox -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="পেজ প্রতি শিট (N-up)" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            <CheckBox x:Name="ChkDrawBorders" Content="বর্ডার আঁকুন" IsChecked="True" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" Click="SettingChanged"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnNup1" Grid.Column="0" Content="1 নরমাল" Height="30" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#2563EB" BorderThickness="1" FontSize="10" Click="Nup_Click" Tag="1"/>
                            <Button x:Name="BtnNup2" Grid.Column="2" Content="2 পেজ" Height="30" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="10" Click="Nup_Click" Tag="2"/>
                            <Button x:Name="BtnNup4" Grid.Column="4" Content="4 পেজ" Height="30" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="10" Click="Nup_Click" Tag="4"/>
                            <Button x:Name="BtnNup6" Grid.Column="6" Content="6 পেজ" Height="30" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="10" Click="Nup_Click" Tag="6"/>
                        </Grid>

                        <!-- Row 4: Orientation & Copies -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ওরিয়েন্টেশন" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox x:Name="OrientCombo" Height="30" SelectionChanged="SettingChanged">
                                    <ComboBoxItem Content="অটো (ফাইলের মতো)" Tag="auto" IsSelected="True"/>
                                    <ComboBoxItem Content="পোর্ট্রেট" Tag="portrait"/>
                                    <ComboBoxItem Content="ল্যান্ডস্কেপ" Tag="landscape"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="কপি সংখ্যা" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <DockPanel Height="30">
                                    <Button Content="-" Width="28" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Click="BtnCopyMinus_Click"/>
                                    <Button Content="+" Width="28" DockPanel.Dock="Right" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Click="BtnCopyPlus_Click"/>
                                    <TextBox x:Name="CopiesText" Text="1" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1,1,1,1"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Summary Compact Strip -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="🖨️ " FontSize="11"/>
                                <TextBlock x:Name="SummaryPrinterName" Text="-" FontSize="11" FontWeight="Bold" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SummaryStatusTag" Text="রেডি" FontSize="9" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock x:Name="SummarySpecs" Text="B&amp;W • A4 • 600 DPI" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="SummarySheets" Text="০ টি কাগজ" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons: Preview & Print All -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Live Sheet Preview Button -->
                        <Button Grid.Column="0" x:Name="BtnPreview" Content="👁️ প্রিভিউ" Height="42" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Click="BtnPreview_Click" ToolTip="প্রিন্ট লেআউট ও N-Up প্রিভিউ দেখুন"/>

                        <!-- One-Click Print Main Button -->
                        <Button Grid.Column="2" x:Name="BtnPrintAll" Height="42" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnPrintAll_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🚀 " FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="এক ক্লিকে প্রিন্ট করুন" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- TAB 2: LIVE WINDOWS PRINT QUEUE VIEW -->
        <Grid Grid.Row="2" x:Name="QueueView" Margin="16" Visibility="Collapsed">
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Queue Header Bar -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="উইন্ডোজ লাইভ প্রিন্ট কিউ" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,12,0"/>
                            <TextBlock x:Name="QueuePrinterTitle" Text="-" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 রিফ্রেশ" Padding="10,4" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" Margin="0,0,8,0" Cursor="Hand" Click="BtnRefreshQueueTab_Click"/>
                            <Button Content="উইন্ডোজ কিউ উইন্ডো খুলুন" Padding="10,4" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" Cursor="Hand" Click="BtnOpenWindowsQueue_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Print Jobs DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="PrintJobsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" BorderThickness="1" BorderBrush="#E2E8F0" Background="White" RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="জব আইডি" Binding="{Binding JobId}" Width="80"/>
                            <DataGridTextColumn Header="ডকুমেন্টের নাম" Binding="{Binding DocumentName}" Width="*"/>
                            <DataGridTextColumn Header="বর্তমান অবস্থা" Binding="{Binding Status}" Width="150"/>
                            <DataGridTextColumn Header="পেজ প্রগ্রেস" Binding="{Binding PagesProgress}" Width="120"/>
                            <DataGridTextColumn Header="সাবমিট সময়" Binding="{Binding TimeSubmitted}" Width="120"/>
                            <DataGridTemplateColumn Header="অ্যাকশন" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="পজ" Width="44" Height="24" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="10" Margin="0,0,4,0" Tag="{Binding JobId}" Click="BtnPauseJob_Click"/>
                                            <Button Content="বাতিল" Width="44" Height="24" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" FontSize="10" Tag="{Binding JobId}" Click="BtnCancelJob_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Queue Empty / Footer Note -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock Text="💡 উইন্ডোজ স্পুলারে পাঠানো যেকোনো প্রিন্ট জব এখানে রিয়েল-টাইমে আপডেট হয়।" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="QueueCountSummaryText" Text="মোট ০টি জব লাইনে আছে" FontSize="11" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
