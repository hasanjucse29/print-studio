<Window x:Class="PrintStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Studio — স্মার্ট ব্যাচ প্রিন্টিং"
        Height="700" Width="1080"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <!-- Brand Left -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="6" Background="#2563EB" Margin="0,0,10,0">
                        <TextBlock Text="🖨️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Print Studio" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="ড্র্যাগ অ্যান্ড ড্রপ ও ওয়ান-ক্লিক সাইলেন্ট পিডিএফ প্রিন্টিং" FontSize="10" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status & About Right -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Live Status Badge -->
                    <Border x:Name="ActivePrinterBadge" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ActivePrinterNameText" Text="প্রিন্টার খোঁজা হচ্ছে..." FontSize="12" Foreground="#334155" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ActivePrinterStatusTag" Text="রেডি" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                        </StackPanel>
                    </Border>

                    <!-- Refresh Button -->
                    <Button x:Name="BtnRefresh" Width="32" Height="32" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand" Click="BtnRefresh_Click">
                        <TextBlock Text="🔄" FontSize="12"/>
                    </Button>

                    <!-- About Tab Button -->
                    <Button x:Name="BtnAbout" Height="32" Padding="12,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" Click="BtnAbout_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️ " FontSize="11" Margin="0,0,2,0"/>
                            <TextBlock Text="About" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area: Left Queue, Right Settings -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Drag Drop & File Queue -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="130"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Drag Drop Zone -->
                <Border Grid.Row="0" x:Name="DropZone" Background="White" BorderBrush="#93C5FD" BorderThickness="2" CornerRadius="8" Padding="12" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" MouseLeftButtonDown="DropZone_Click" Cursor="Hand" Margin="0,0,0,12">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="☁️" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="পিডিএফ ফাইলগুলো এখানে ড্র্যাগ করে ছেড়ে দিন" FontSize="13" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                        <TextBlock Text="অথবা কম্পিউটার থেকে ফাইল সিলেক্ট করতে এখানে ক্লিক করুন" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Queue Header -->
                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock x:Name="QueueStatsText" Text="প্রিন্ট কিউ (০টি ফাইল • মোট ০ পেজ)" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnClearAll" Content="সব মুছুন" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Padding="8,4" FontSize="11" Margin="0,0,6,0" Cursor="Hand" Click="BtnClearAll_Click"/>
                        <Button x:Name="BtnAddMore" Content="+ আরও যোগ করুন" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,4" FontSize="11" Cursor="Hand" Click="BtnAddMore_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- File Cards List -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6">
                    <ListBox x:Name="FileList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Thumbnail -->
                                        <Border Grid.Column="0" Width="50" Height="65" Background="#E2E8F0" CornerRadius="4" Margin="0,0,10,0">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- File Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="#64748B" Margin="0,2,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding PageCount, StringFormat='{}{0} পেজ'}" FontSize="10" FontWeight="SemiBold" Foreground="#2563EB"/>
                                                </Border>
                                                <TextBlock Text="{Binding DetectedOrientation, StringFormat='ওরিয়েন্টেশন: {0}'}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Item Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="পেজ রেঞ্জ" FontSize="9" Foreground="#64748B"/>
                                                <TextBox Text="{Binding PageRange, Mode=TwoWay}" Width="70" Height="24" FontSize="11" Padding="2" TextAlignment="Center"/>
                                            </StackPanel>
                                            <Button Content="✕" Width="26" Height="26" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Tag="{Binding Id}" Click="BtnRemoveItem_Click" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- RIGHT: Print Settings & One-Click Print -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Settings Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="⚙️ প্রিন্ট সেটিংস (Global)" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="সব ফাইলের জন্য" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- Settings Form Controls -->
                    <StackPanel Grid.Row="1">
                        <!-- Printer Select -->
                        <TextBlock Text="কানেক্টেড প্রিন্টার" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PrinterCombo" Height="32" SelectionChanged="PrinterCombo_SelectionChanged" Margin="0,0,0,10"/>

                        <!-- Row 1: Color & Quality -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="কালার মোড" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ColorCombo" Height="30" SelectionChanged="SettingChanged">
                                    <ComboBoxItem Content="B&amp;W (সাদা-কালো)" Tag="bw" IsSelected="True"/>
                                    <ComboBoxItem Content="কালার (Color)" Tag="color"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="কোয়ালিটি (DPI)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox x:Name="QualityCombo" Height="30" SelectionChanged="SettingChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Paper Size & Duplex -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="সাইজ" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox x:Name="PaperCombo" Height="30" SelectionChanged="SettingChanged">
                                    <ComboBoxItem Content="A4 (210×297)" Tag="A4" IsSelected="True"/>
                                    <ComboBoxItem Content="Letter" Tag="Letter"/>
                                    <ComboBoxItem Content="Legal" Tag="Legal"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ডুপ্লেক্স" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox x:Name="DuplexCombo" Height="30" SelectionChanged="SettingChanged">
                                    <ComboBoxItem Content="সিঙ্গেল (একপিঠ)" Tag="simplex" IsSelected="True"/>
                                    <ComboBoxItem Content="ডুপ্লেক্স (বইয়ের মতো)" Tag="vertical"/>
                                    <ComboBoxItem Content="ডুপ্লেক্স (শর্ট এজ)" Tag="horizontal"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: N-Up Selection -->
                        <TextBlock Text="পেজ প্রতি শিট (N-up)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnNup1" Grid.Column="0" Content="1 নরমাল" Height="30" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#2563EB" BorderThickness="1" FontSize="10" Click="Nup_Click" Tag="1"/>
                            <Button x:Name="BtnNup2" Grid.Column="2" Content="2 পেজ" Height="30" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="10" Click="Nup_Click" Tag="2"/>
                            <Button x:Name="BtnNup4" Grid.Column="4" Content="4 পেজ" Height="30" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="10" Click="Nup_Click" Tag="4"/>
                            <Button x:Name="BtnNup6" Grid.Column="6" Content="6 পেজ" Height="30" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="10" Click="Nup_Click" Tag="6"/>
                        </Grid>

                        <!-- Row 4: Orientation & Copies -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ওরিয়েন্টেশন" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox x:Name="OrientCombo" Height="30" SelectionChanged="SettingChanged">
                                    <ComboBoxItem Content="অটো (ফাইলের মতো)" Tag="auto" IsSelected="True"/>
                                    <ComboBoxItem Content="পোর্ট্রেট" Tag="portrait"/>
                                    <ComboBoxItem Content="ল্যান্ডস্কেপ" Tag="landscape"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="কপি সংখ্যা" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <DockPanel Height="30">
                                    <Button Content="-" Width="28" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Click="BtnCopyMinus_Click"/>
                                    <Button Content="+" Width="28" DockPanel.Dock="Right" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Click="BtnCopyPlus_Click"/>
                                    <TextBox x:Name="CopiesText" Text="1" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1,1,1,1"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Summary Compact Strip -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="🖨️ " FontSize="11"/>
                                <TextBlock x:Name="SummaryPrinterName" Text="-" FontSize="11" FontWeight="Bold" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SummaryStatusTag" Text="রেডি" FontSize="9" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock x:Name="SummarySpecs" Text="B&amp;W • A4 • 600 DPI" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="SummarySheets" Text="০ টি কাগজ" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Print All Main Button -->
                    <Button Grid.Row="3" x:Name="BtnPrintAll" Height="42" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnPrintAll_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🚀 " FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="এক ক্লিকে প্রিন্ট করুন" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
