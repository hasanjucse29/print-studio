<Window x:Class="PrintStudio.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Print Studio"
        Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="48" Height="48" CornerRadius="8" Background="#2563EB" Margin="0,0,14,0">
                <TextBlock Text="🖨️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Print Studio" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                    <Border Background="#EFF6FF" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                        <TextBlock Text="v2.0 Native Edition" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="উইন্ডোজ নেটিভ ব্যাচ প্রিন্টিং ও N-Up ইঞ্জিন" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Developer Info Card -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Md Hasan Al Mamun" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Department of Computer Science &amp; Engineering" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                <TextBlock Text="Jahangirnagar University (JU CSE 29)" FontSize="12" Foreground="#64748B"/>
                
                <Separator Margin="0,10,0,10" Background="#F1F5F9"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✉️ " FontSize="12"/>
                    <TextBlock Text="jucse29.399@gmail.com" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Cursor="Hand" MouseDown="Email_MouseDown"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="🐙 " FontSize="12"/>
                    <TextBlock Text="GitHub: hasanjucse29/print-studio" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Cursor="Hand" MouseDown="GitHub_MouseDown"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Technical Highlights -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="⚡ 100% C# .NET Native — Instant startup (under 0.4s)" FontSize="11" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBlock Text="🛡️ Local Processing — সম্পূর্ণ অফলাইন ও নিরাপদ স্পুলিং" FontSize="11" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBlock Text="🎛️ Windows GDI Spooler — কোনো বাহ্যিক ড্রাইভার ছাড়াই প্রিন্ট" FontSize="11" Foreground="#334155"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3">
            <TextBlock Text="© 2026 Md Hasan Al Mamun. All rights reserved." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
            <Button Content="ঠিক আছে" Width="80" Height="30" HorizontalAlignment="Right" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
